{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "rootDir": "../..",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "../print-bridge/diagnostics.cjs", "../../packages/printing/src/index.ts"]
}
