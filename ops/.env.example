# Local development only. Copy to ignored ops/.env and supply your own password.
POSTGRES_PASSWORD=
API_PORT=4000
# Hostinger SMTP authenticates as info@wokandchop.ca. Set the mailbox password here only.
# Leaving this empty records notification previews and keeps password reset email disabled.
WOK_SMTP_PASSWORD=
# HTTPS origin of the customer site that serves offer links and handles unsubscribe requests.
WOK_MARKETING_PUBLIC_URL=
# Promotions and confirmations share this 24-hour budget, separate from transactional messages.
WOK_MARKETING_DAILY_LIMIT=50
# Exact Windows printer name from Settings > Printers & scanners on the PC running the local API.
WOK_WINDOWS_PRINTER=
# No Stripe credentials are needed: the current API cannot accept payments.
# Set runtime provider secrets only after the integration has been implemented.
